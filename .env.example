GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.8-live

# Options: "Kore", "Puck", "Charon", "Aoede", "Fenrir", Can also be changed by pressing (V)
VOICE_NAME=Kore

# Set to an integer device index or leave empty for OS default
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# System Prompt / Assistant Persona
SYSTEM_INSTRUCTION="You are a brilliant, fast, and natural conversational voice assistant. Keep answers concise, direct, and conversational without markdown formatting."
